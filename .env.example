# Cloudflare D1
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# Voter session (HMAC secret for the session cookie; 32+ random characters)
SESSION_SECRET=""

# OIDC via Supabase OAuth 2.1 server (issuer derived from PUBLIC_SUPABASE_URL).
# OIDC_CLIENT_ID is inlined at build time; OIDC_CLIENT_SECRET is a runtime secret.
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""

# Valid ballots needed before results unlock (build time). Leave empty until decided;
# results stay locked and the pages say the minimum will be defined later.
RESULTS_THRESHOLD=""

# Supabase (public values). Used by the OAuth consent page.
PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"

# Sentry (build time, public; see src/env.ts). Without a DSN nothing is sent.
# Format: https://<key>@<org-id>.ingest.<region>.sentry.io/<project-id>
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0.25"
# Where browsers report CSP violations (Sentry → Project Settings → Security Headers).
# Format: https://<org-id>.ingest.<region>.sentry.io/api/<project-id>/security/?sentry_key=<key>
SENTRY_CSP_REPORT_URI=""
# Source map upload (build only). Without a token no maps are uploaded.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="<org-slug>"
SENTRY_PROJECT="<project-slug>"
